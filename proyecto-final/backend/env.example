# Configuración de entorno para el backend de La Estrellita
# Copia este archivo a un archivo de entorno local según la instrucción del README:
#   Copy-Item env.example .env (PowerShell) o cp env.example .env (Bash)

# URL de la base de datos SQLite síncrona
DATABASE_URL=sqlite:///./la_estrellita.db

# Secreto para firma de tokens JWT (generar con secrets.token_hex(32), mínimo 32 caracteres)
# Nunca uses valores por defecto ni cadenas triviales en producción
JWT_SECRET=REEMPLAZAR_CON_TOKEN_HEX_DE_32_BYTES_MINIMO_0123456789abcdef

# Minutos de validez del token JWT (1 a 120)
TOKEN_MINUTES=30

# Orígenes CORS permitidos en formato de lista JSON
CORS_ORIGINS=["http://localhost:5173"]
